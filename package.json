{
  "name": "portal-vacaciones",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Portal de Vacaciones Go Productivity: frontend estático (S3 + CloudFront) y API en AWS Lambda.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"backend/test/*.test.mjs\"",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "infra:tablas": "node infra/create-tables.mjs",
    "infra:config": "node infra/seed-config.mjs",
    "infra:migrar": "node infra/migrate-legacy.mjs",
    "deploy:api": "node infra/deploy-api.mjs",
    "deploy:web": "node infra/deploy-web.mjs",
    "deploy": "npm run deploy:api && npm run deploy:web"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudfront": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-iam": "^3.700.0",
    "@aws-sdk/client-lambda": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sesv2": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0"
  }
}

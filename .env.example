APP_BASE_URL=http://localhost:3000
AWS_REGION=us-east-1

# Opcional. Solo lo usan las 2 paginas fuera de esta migracion (Reporte de
# Capacidad TI / Reporte MVP's, ver public/reporte_capacidad.html y
# public/reporte_mvp.html). Por defecto ya solo permiten esas 2 tablas.
# ALLOWED_TABLES=NAVE_Reporte_Capacidades,NAVE_Reporte_General_MVPs
# ALLOWED_LAMBDAS=

# Firma las sesiones (JWT). Genera uno nuevo por entorno, minimo 32 caracteres.
# Ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_TOKEN_SECRET=

# Desarrollo local: credenciales de tu usuario/perfil de AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Produccion (Amplify): el compute SSR de esta app no recoge el rol de
# servicio de Amplify en runtime, asi que se usan estas 2 variables (nombre
# propio para no chocar con los nombres reservados de Lambda
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY). Usa un usuario IAM dedicado con
# permisos limitados solo a las tablas/funciones NAVE (ver
# docs/amplify-migration.md), nunca una llave de administrador.
NAVE_AWS_ACCESS_KEY_ID=
NAVE_AWS_SECRET_ACCESS_KEY=
